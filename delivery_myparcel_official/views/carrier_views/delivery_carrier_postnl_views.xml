                        <!--                        <div name="morning_delivery">-->
                        <!--                            <field name="x_aa_mp_allow_morning_delivery"/>-->
                        <!--                            <field name="x_aa_mp_morning_delivery_price" widget="monetary" class="oe_inline"-->
                        <!--                                   invisible="not x_aa_mp_allow_morning_delivery or x_aa_mp_delivery_price != 'fixed'"/>-->
                        <!--                        </div>-->
                        <!--                        <label for="x_aa_mp_allow_evening_delivery"/>-->
                        <!--                        <div name="evening_delivery">-->
                        <!--                            <field name="x_aa_mp_allow_evening_delivery"/>-->
                        <!--                            <field name="x_aa_mp_evening_delivery_price" widget="monetary" class="oe_inline"-->
                        <!--                                   invisible="not x_aa_mp_allow_evening_delivery or x_aa_mp_delivery_price != 'fixed'"/>-->
                        <!--                        </div>-->
                        <!--                        <label for="x_aa_mp_allow_monday_delivery"/>-->
                        <!--                        <div name="monday_delivery">-->
                        <!--                            <field name="x_aa_mp_allow_monday_delivery"/>-->
                        <!--                            <field name="x_aa_mp_monday_delivery_price" widget="monetary" class="oe_inline"-->
                        <!--                                   invisible="not x_aa_mp_allow_monday_delivery or x_aa_mp_delivery_price != 'fixed'"/>-->
