<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_delivery_carrier_form_inherit_myparcel_dhl_fy" model="ir.ui.view">
            <field name="name">delivery.carrier.inherit.myparcel.dhl_fy</field>
            <field name="model">delivery.carrier</field>
            <field name="inherit_id" ref="delivery_myparcel.view_delivery_carrier_form_inherit_myparcel"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='myparcel_carrier_settings']" position="inside">
                    <group string="Package Settings" invisible="delivery_type != 'myparcel_dhl_fy'">
                        <field name="x_aa_mp_package_type_id"
                               domain="[('package_carrier_type', '=', 'myparcel_dhl_fy')]"/>
                    </group>
                    <group string="Insurance" invisible="delivery_type != 'myparcel_dhl_fy'" col="1" colspan="4">
                        <group>
                            <field name="x_aa_mp_insurance_pricelist_id" nolabel="1" colspan="2"
                                   domain="[('delivery_type', '=', 'myparcel_dhl_fy')]">
                                <list editable="bottom">
                                    <field name="currency_id" column_invisible="1"/>
                                    <!--                                    <field name="name"/>-->
                                    <field name="x_aa_mp_insurance_selection"/>
                                    <field name="currency_id" string="Currency"/>
                                    <field name="price" widget="monetary"/>
                                </list>
                            </field>
                        </group>
                    </group>
                    <group string="Carrier settings: DHL For You"
                           invisible="delivery_type != 'myparcel_dhl_fy'">
                        <label for="x_aa_mp_age_control"/>
                        <div name="age_control_price">
                            <field name="x_aa_mp_age_control"/>
                            <field name="x_aa_mp_age_control_price" widget="monetary" class="oe_inline"
                                   invisible="not x_aa_mp_age_control or x_aa_mp_delivery_price != 'fixed'"/>
                        </div>
                        <label for="x_aa_mp_signing"/>
                        <div name="signing_price">
                            <field name="x_aa_mp_signing"/>
                            <field name="x_aa_mp_signing_price" widget="monetary" class="oe_inline"
                                   invisible="not x_aa_mp_signing or x_aa_mp_delivery_price != 'fixed'"/>
                        </div>
                        <label for="x_aa_mp_only_receiver"/>
                        <div name="only_receiver">
                            <field name="x_aa_mp_only_receiver"/>
                            <field name="x_aa_mp_only_receiver_price" widget="monetary" class="oe_inline"
                                   invisible="not x_aa_mp_only_receiver or x_aa_mp_delivery_price != 'fixed'"/>
                        </div>
                        <field name="x_aa_mp_hide_sender"/>
                        <!--                        <label for="x_aa_mp_direct_return"/>-->
                        <!--                        <div name="direct_return">-->
                        <!--                            <field name="x_aa_mp_direct_return"/>-->
                        <!--                            <field name="x_aa_mp_direct_return_price" widget="monetary" class="oe_inline"-->
                        <!--                                   invisible="not x_aa_mp_direct_return or x_aa_mp_delivery_price != 'fixed'"/>-->
                        <!--                        </div>-->
                        <!--                        <field name="x_aa_mp_home_delivery"/>-->
                        <!--                        <label for="x_aa_mp_allow_standard_delivery"/>-->
                        <!--                        <div name="standard_delivery">-->
                        <!--                            <field name="x_aa_mp_allow_standard_delivery"/>-->
                        <!--                            <field name="x_aa_mp_standard_delivery_price" widget="monetary" class="oe_inline"-->
                        <!--                                   invisible="not x_aa_mp_allow_standard_delivery or x_aa_mp_delivery_price != 'fixed'"/>-->
                        <!--                        </div>-->
                        <label for="x_aa_mp_allow_sameday_delivery"/>
                        <div name="standard_delivery">
                            <field name="x_aa_mp_allow_sameday_delivery"/>
                            <field name="x_aa_mp_sameday_delivery_price" widget="monetary" class="oe_inline"
                                   invisible="not x_aa_mp_allow_sameday_delivery or x_aa_mp_delivery_price != 'fixed'"/>
                        </div>
                        <!--                        <label for="x_aa_mp_allow_monday_delivery"/>-->
                        <!--                        <div name="monday_delivery">-->
                        <!--                            <field name="x_aa_mp_allow_monday_delivery"/>-->
                        <!--                            <field name="x_aa_mp_monday_delivery_price" widget="monetary" class="oe_inline"-->
                        <!--                                   invisible="not x_aa_mp_allow_monday_delivery or x_aa_mp_delivery_price != 'fixed'"/>-->
                        <!--                        </div>-->
                        <!--                        <label for="x_aa_mp_allow_saturday_delivery"/>-->
                        <!--                        <div name="saturday_delivery">-->
                        <!--                            <field name="x_aa_mp_allow_saturday_delivery"/>-->
                        <!--                            <field name="x_aa_mp_saturday_delivery_price" widget="monetary" class="oe_inline"-->
                        <!--                                   invisible="not x_aa_mp_allow_saturday_delivery or x_aa_mp_delivery_price != 'fixed'"/>-->
                        <!--                        </div>-->
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>