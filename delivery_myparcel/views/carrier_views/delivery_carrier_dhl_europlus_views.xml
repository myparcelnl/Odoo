<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_delivery_carrier_form_inherit_myparcel_dhl_europlus" model="ir.ui.view">
            <field name="name">delivery.carrier.inherit.myparcel.dhl_europlus</field>
            <field name="model">delivery.carrier</field>
            <field name="inherit_id" ref="delivery_myparcel.view_delivery_carrier_form_inherit_myparcel"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='myparcel_carrier_settings']" position="inside">
                    <group string="Package Settings" invisible="delivery_type != 'myparcel_dhl_europlus'">
                        <field name="x_aa_mp_package_type_id"
                               domain="[('package_carrier_type', '=', 'myparcel_dhl_europlus')]" />
                    </group>
                    <group string="Insurance" invisible="delivery_type != 'myparcel_dhl_europlus'" col="1" colspan="4">
                        <group>
                            <field name="x_aa_mp_insurance_pricelist_id" nolabel="1" colspan="2"
                                   domain="[('delivery_type', '=', 'myparcel_dhl_europlus')]">
                                <list editable="bottom">
                                    <field name="currency_id" column_invisible="1"/>
<!--                                    <field name="name"/>-->
                                    <field name="x_aa_mp_insurance_selection"/>
                                    <field name="currency_id" string="Currency"/>
                                    <field name="price" widget="monetary"/>
                                </list>
                            </field>
                        </group>
                    </group>
                    <group string="Carrier settings: DHL Europlus"
                           invisible="delivery_type != 'myparcel_dhl_europlus'">
                        <field name="x_aa_mp_signing" readonly="delivery_type == 'myparcel_dhl_europlus'"/>
                        <field name="x_aa_mp_hide_sender"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>