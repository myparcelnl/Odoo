<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_delivery_carrier_form_inherit_myparcel_dpd" model="ir.ui.view">
            <field name="name">delivery.carrier.inherit.myparcel.dpd</field>
            <field name="model">delivery.carrier</field>
            <field name="inherit_id" ref="delivery_myparcel.view_delivery_carrier_form_inherit_myparcel"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='myparcel_carrier_settings']" position="inside">
                    <group string="Carrier settings: DPD" invisible="delivery_type != 'myparcel_dpd'">
                        <field name="x_aa_mp_home_delivery"/>
                        <label for="x_aa_mp_allow_standard_delivery"/>
                        <div name="standard_delivery">
                            <field name="x_aa_mp_allow_standard_delivery"/>
                            <field name="x_aa_mp_standard_delivery_price" widget="monetary" class="oe_inline"
                                   invisible="not x_aa_mp_allow_standard_delivery or x_aa_mp_delivery_price != 'fixed'"/>
                        </div>
                        <label for="x_aa_mp_allow_monday_delivery"/>
                        <div name="monday_delivery">
                            <field name="x_aa_mp_allow_monday_delivery"/>
                            <field name="x_aa_mp_monday_delivery_price" widget="monetary" class="oe_inline"
                                   invisible="not x_aa_mp_allow_monday_delivery or x_aa_mp_delivery_price != 'fixed'"/>
                        </div>
                        <label for="x_aa_mp_allow_saturday_delivery"/>
                        <div name="saturday_delivery">
                            <field name="x_aa_mp_allow_saturday_delivery"/>
                            <field name="x_aa_mp_saturday_delivery_price" widget="monetary" class="oe_inline"
                                   invisible="not x_aa_mp_allow_saturday_delivery or x_aa_mp_delivery_price != 'fixed'"/>
                        </div>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>