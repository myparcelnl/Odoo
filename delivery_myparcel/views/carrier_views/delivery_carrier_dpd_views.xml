<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_delivery_carrier_form_inherit_myparcel_dpd" model="ir.ui.view">
            <field name="name">delivery.carrier.inherit.myparcel.dpd</field>
            <field name="model">delivery.carrier</field>
            <field name="inherit_id" ref="delivery_myparcel.view_delivery_carrier_form_inherit_myparcel"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='myparcel_carrier_settings']" position="inside">
                    <group string="Package Settings" invisible="delivery_type != 'myparcel_dpd'">
                        <field name="x_aa_mp_package_type_id" domain="[('package_carrier_type', '=', 'myparcel_dpd')]"/>
                    </group>
                    <group string="Carrier settings: DPD" invisible="delivery_type != 'myparcel_dpd'">
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>