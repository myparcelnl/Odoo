<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_order_form_inherit_myparcel" model="ir.ui.view">
            <field name="name">sale.order.inherit.myparcel</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='order_details']" position="inside">
                    <field name="x_aa_mp_is_myparcel" invisible="1"/>
                </xpath>
                <xpath expr="//page[@name='other_information']" position="after">
                    <page name="myparcel_settings" string="MyParcel Settings"
                          invisible="x_aa_mp_is_myparcel == False">
                        <group>
                            <group string="MyParcel Carrier Settings">
                                <field name="carrier_id" readonly="1"/>
                                <field name="x_aa_mp_selected_carrier" invisible="1"/>
                                <field name="x_aa_mp_age_control"
                                       invisible="x_aa_mp_selected_carrier not in ['myparcel_postnl', 'myparcel_ups', 'myparcel_dhl_fy']"
                                       readonly="1"/>
                                <field name="x_aa_mp_signing"
                                       invisible="x_aa_mp_selected_carrier not in ['myparcel_postnl', 'myparcel_ups', 'myparcel_dhl_fy', 'myparcel_dhl_europlus']"
                                       readonly="1"/>
                                <field name="x_aa_mp_only_receiver"
                                       invisible="x_aa_mp_selected_carrier not in ['myparcel_postnl', 'myparcel_ups', 'myparcel_dhl_fy']"
                                       readonly="1"/>
                                <field name="x_aa_mp_hide_sender"
                                       invisible="x_aa_mp_selected_carrier not in ['myparcel_dhl_fy', 'myparcel_dhl_europlus']"
                                       readonly="1"/>
                                <field name="x_aa_mp_allow_sameday_delivery"
                                       invisible="x_aa_mp_selected_carrier not in ['myparcel_dhl_fy']"
                                       readonly="1"/>
<!--                                <field name="x_aa_mp_receiving_code"-->
<!--                                       invisible="x_aa_mp_selected_carrier != 'myparcel_postnl'"-->
<!--                                       readonly="1"/>-->
<!--                                <field name="x_aa_mp_large_package"-->
<!--                                       invisible="x_aa_mp_selected_carrier != 'myparcel_postnl'" -->
<!--                                       readonly="1"/>-->
<!--                                <field name="x_aa_mp_direct_return"-->
<!--                                       invisible="x_aa_mp_selected_carrier not in ['myparcel_postnl', 'myparcel_ups', 'myparcel_dhl_fy']"-->
<!--                                       readonly="1"/>-->
<!--                                <field name="x_aa_mp_insurance"-->
<!--                                       invisible="x_aa_mp_selected_carrier != 'myparcel_postnl'"-->
<!--                                       readonly="1"/>-->
<!--                                <field name="x_aa_mp_package_collection_carrier"-->
<!--                                       invisible="x_aa_mp_selected_carrier != 'myparcel_ups'"-->
<!--                                       readonly="1"/>-->
<!--                                <field name="x_aa_mp_home_delivery"-->
<!--                                       invisible="x_aa_mp_selected_carrier not in ['myparcel_postnl', 'myparcel_ups', 'myparcel_dpd']"-->
<!--                                       readonly="1"/>-->
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>